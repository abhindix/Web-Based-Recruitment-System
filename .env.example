# Copy this file to .env and fill in your values before running docker-compose.
#   cp .env.example .env

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=app
# REQUIRED — choose a strong password.
POSTGRES_PASSWORD=change_me_strong_password

# ─── JWT ──────────────────────────────────────────────────────────────────────
# REQUIRED — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_strong_jwt_secret

# ─── Seed admin user (optional) ───────────────────────────────────────────────
# If set, a manager account is created automatically on first startup.
# Leave both empty to skip seeding.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── LLM (optional) ───────────────────────────────────────────────────────────
# Leave LLM_API_KEY empty to run the app without AI chat.
# LM Studio works out of the box — start its local server and set these values.
LLM_BASE_URL=http://host.docker.internal:1234/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b

# ─── SMTP / Email (optional) ──────────────────────────────────────────────────
# Leave SMTP_HOST empty to use the dev-mode console mock instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
